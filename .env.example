# ── Application (REQUIRED) ────────────────────────────────────────────
# Absolute HTTPS URL for the production deployment.
# Used in canonical, OG, Twitter, JSON-LD, and build validation.
VITE_PUBLIC_APP_URL="https://isabella-mexa.vercel.app"
# Aliases locales/operativos del mismo origen.
PUBLIC_APP_URL="https://isabella-mexa.vercel.app"
APP_URL="https://isabella-mexa.vercel.app"

# ── Supabase ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
SUPABASE_JWT_SECRET="YOUR_JWT_SECRET"
# Claves de pago/secret del proyecto (dashboard Supabase → Integrations).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."

# Postgres de Supabase (prefijadas para coexistir con el primario Neon).
SUPABASE_SERVICE_ROLE_KEY_POSTGRES_URL="postgres://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&supa=base-pooler.x"
SUPABASE_SERVICE_ROLE_KEY_POSTGRES_URL_NON_POOLING="postgres://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"
SUPABASE_SERVICE_ROLE_KEY_POSTGRES_PRISMA_URL="postgres://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
SUPABASE_SERVICE_ROLE_KEY_POSTGRES_HOST="db.YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY_POSTGRES_USER="postgres"
SUPABASE_SERVICE_ROLE_KEY_POSTGRES_PASSWORD="YOUR_PASSWORD"
SUPABASE_SERVICE_ROLE_KEY_POSTGRES_DATABASE="postgres"

# ── PostgreSQL (primario — Neon) ──────────────────────────────────────
# El runtime usa un Pool de pg con POSTGRES_URL; DATABASE_URL (pooler Neon)
# es el paquete recomendado por Neon para la mayoría de usos.
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
# Conexiones sin pgbouncer:
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
# Prisma: conexión directa (sin pooler) para migraciones / tareas de larga duración
DIRECT_URL=${DATABASE_URL_UNPOOLED}

# Parámetros para construir tu propia connection string
PGHOST="ep-xxxx-pooler.region.aws.neon.tech"
PGHOST_UNPOOLED="ep-xxxx.region.aws.neon.tech"
PGUSER="neondb_owner"
PGDATABASE="neondb"
PGPASSWORD="PASSWORD"

# Parámetros para Vercel Postgres Templates
POSTGRES_URL="postgresql://neondb_owner:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://neondb_owner:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
POSTGRES_URL_NO_SSL="postgresql://neondb_owner:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb"
POSTGRES_PRISMA_URL="postgresql://neondb_owner:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?channel_binding=require&connect_timeout=15&sslmode=require"
POSTGRES_HOST="ep-xxxx-pooler.region.aws.neon.tech"
POSTGRES_USER="neondb_owner"
POSTGRES_PASSWORD="PASSWORD"
POSTGRES_DATABASE="neondb"

# ── Prisma Postgres ───────────────────────────────────────────────────
DATABASE_PRISMA_DATABASE_URL="postgres://USER:sk_...@db.prisma.io:5432/postgres?sslmode=require"
DATABASE_PRISMA_POSTGRES_URL="postgres://USER:sk_...@db.prisma.io:5432/postgres?sslmode=require"

# ── Auth & Security ──────────────────────────────────────────────────
# HS256 secret for JWT signing. Required in production.
# When omitted, native-auth auto-generates and persists to SQLite.
ISABELLA_AUTH_SECRET=""

# HMAC pepper for API key digest. Minimum 32 bytes.
# When omitted, falls back to native-auth secret.
API_KEY_PEPPER=""

# CORS origins (comma-separated). Required in production; no wildcard origins.
CANONICAL_ORIGINS="https://isabella-mexa.vercel.app"

# Require Origin header validation (production: true)
REQUIRE_ORIGIN="false"

# Distributed rate limiting/session state. Se requiere en producción al menos
# uno de estos backends:
#   - REDIS_URL (conexión directa con ioredis, p.ej. Redis Cloud)
#   - UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN (Upstash REST)
# Sin ninguno, el rate limiting cae a memoria del proceso (solo single-node).
REDIS_URL=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
RATE_LIMIT_PER_MINUTE=120
# OBLIGAR backend Redis distribuido (true en producción multi-nodo):
REQUIRE_DISTRIBUTED_RATE_LIMIT="false"

# ── Voice API (edge-tts — gratuito, sin key) ─────────────────────────
# No se requieren credenciales de Azure. Solo: pip install edge-tts

# Express → Voice API proxy URL
VOICE_API_URL="http://localhost:8001"

# Voice synthesis defaults
DEFAULT_RATE=0.92
DEFAULT_PITCH=-1
DEFAULT_VOLUME=0
MAX_TEXT_LENGTH=1000
MAX_REQUESTS_PER_MINUTE=20

# ── Optional Services ─────────────────────────────────────────────────
GEMINI_API_KEY=""

# Billing real con Stripe. Cuando STRIPE_SECRET_KEY está presente el checkout
# crea Checkout Sessions reales; sin ella se cae a contacto comercial.
# Precios objetivo (25% bajo promedio de mercado): Plus $15 · Premium $22.49 ·
# VIP $37.49 · Enterprise $112.50 (USD/mes).
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# MCP de Stripe (integración tooling / agentes).
STRIPE_MCP_KEY=""
STRIPE_WEBHOOK_SECRET=""
BILLING_CHECKOUT_BASE_URL="http://localhost:3000"
# Los STRIPE_PRICE_* se autopueblan en el arranque por ensureStripeCatalog().
STRIPE_PRICE_PLUS=""
STRIPE_PRICE_PREMIUM=""
STRIPE_PRICE_VIP=""
STRIPE_PRICE_ENTERPRISE=""

# BrainTrust (nuevo) — evaluación/LLMOps del join Victoria 1.0. Requiere
# BRAINTRUST_API_KEY + BRAINTRUST_PROJECT_ID para telemetría de modelos.
BRAINTRUST_API_KEY=""
BRAINTRUST_PROJECT_ID=""

# Idlen advertising (optional — pixel loads only after consent)
IDLEN_API_KEY=""

# ── Billing / checkout flags ─────────────────────────────────────────
ENABLE_MOCK_CHECKOUT="false"
# Permitir fallback de auth a modo desarrollo local (nunca true en producción).
ALLOW_DEV_AUTH_FALLBACK="true"

# ── Server Configuration ─────────────────────────────────────────────
PORT=3000
LOG_LEVEL="info"
DISABLE_HMR="false"

# ── Infrastructure ────────────────────────────────────────────────────
# SQLite database path (default: ./data/isabella.db)
ISABELLA_DB_PATH=""

# Durable JSON storage directory (default: .isabella-data)
ISABELLA_DATA_DIR=""

# Node identity for multi-node mesh
NEXT_PUBLIC_NODE_ID="nd-rdm-nodo-cero"

# Event bus signing key (required in production)
ATLAS_EVENT_SIGNING_KEY=""

# ── Serverless / Vercel ──────────────────────────────────────────────
API_TIMEOUT_SECONDS=60
API_MAX_URL_LENGTH=4096
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_RESET_MS=30000
# Gateways de API/AI (Vercel Connect / AI Gateway).
API_GATEWAY_VERCEL=""
AI_GATEWAY_API_KEY=""

# ── Creator economy vault (secreto operativo) ────────────────────────
CREATOR_VAULT_KEY=""

# ── Statsig Feature Management ───────────────────────────────────────
STATSIG_SERVER_API_KEY=""
VITE_STATSIG_CLIENT_KEY=""
EXPERIMENTATION_CONFIG=""
EXPERIMENTATION_CONFIG_ITEM_KEY=""

# ── Lab Mode (PQC / HSM / TEE prototypes) ───────────────────────────
# Servidor: habilita PQC/HSM/TEE simulados. NUNCA true en producción (NO son cripto real).
FEATURE_LAB_MODE="false"

# Navegador (Vite): habilita HSM-sim/TEE en desarrollo local. NUNCA true en producción.
VITE_FEATURE_LAB_MODE="false"

# ── Quantum Stack ────────────────────────────────────────────────────
QUANTUM_BRIDGE_TIMEOUT_MS=8000
PYTHON_BIN="python3"
QUANTUM_BRIDGE_SCRIPT="scripts/quantum/isabella_quantum_bridge_v3.py"
PENNYLANE_ENABLE_LIGHTNING="0"
QUANTUM_MAX_QUEUE=64
ISABELLA_AUDIT_DB="./data/isabella-audit.db"
ISABELLA_KEY_DIR="./secrets/isabella"
ISABELLA_WORKER_ID="quantum-worker-01"
QUANTUM_MAX_INPUT_BYTES="131072"
QUANTUM_MAX_OUTPUT_BYTES="4194304"
QUANTUM_MAX_WIRES="32"
QUANTUM_MAX_SHOTS="500000"
QUANTUM_MAX_FEATURES="64"
QUANTUM_MAX_WEIGHTS="128"
QUANTUM_MAX_LATENCY_MS="45000"

# HSM endpoints (YubiHSM / simulator)
HSM_PRIMARY_ENDPOINT="yubihsm-simulator-primary"
HSM_BACKUP_ENDPOINT="yubihsm-simulator-backup"
HSM_TIMEOUT_MS=5000
HSM_CB_THRESHOLD=5

# ── Client-side (Vite-injected) ──────────────────────────────────────
VITE_APP_VERSION="0.0.0"
VITE_CHECKOUT_ORIGINS=""