  "policyModel": "default-deny",
  "authorization": {
    "policyModel": "default-deny",
    "wildcardPolicy": "system-role-only",
    "elevationPolicy": "forbidden",
    "description": "Scopes are necessary but not sufficient. Authorization is the intersection of identity + tenant + scope + role + assurance + session + step-up + resource context + budget + policy."
  },
  "authentication": {
    "requiredClaims": [
      "sub", "tenantId", "scopes", "roles", "iat", "exp", "jti", "iss", "aud"
    ],
    "clockSkewSeconds": 30,
    "maxTokenLifetimeSeconds": 86400,
    "issuer": "https://auth.isabella.ai",
    "audience": "isabella-api"
  },
  "assuranceLevels": {
    "local": {
      "rank": 1,
      "description": "Standard JWT authentication over HTTPS. Sufficient for read operations and low-risk writes within a single tenant."
    },
    "mtls": {
      "rank": 2,
      "description": "Mutual TLS with client certificate. Required for cross-service calls, provider configuration, and medium-risk operations."
    },
    "hardware-backed": {
      "rank": 3,
      "description": "Hardware-backed identity via WebAuthn, HSM, or TEE attestation. Required for policy changes, kill-switch, key management, and all critical operations."
    }
  },
  "roles": {
    "citizen": { "rank": 1, "description": "End user. Read access to own tenant data." },
    "agent": { "rank": 2, "description": "Automated agent with scoped write access." },
    "operator": { "rank": 3, "description": "System operator. Can manage tools, quantum jobs, and automation." },
    "admin": { "rank": 4, "description": "Administrative access. Cannot change policy or manage secrets." },
    "governance_admin": { "rank": 5, "description": "Policy and governance authority. Requires hardware-backed step-up." },
    "system": { "rank": 6, "description": "Automated system principal. Only role that may use wildcard scope." }
  },
