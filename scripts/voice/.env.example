# Isabella Voice API — Variables de entorno
# Copiar a .env y completar los valores

# ── Motor ──────────────────────────────────────────────────────────────
# edge-tts: GRATUITO, sin API key, misma voz Microsoft Neural
# No se requieren credenciales. Solo instalar: pip install edge-tts

# ── Síntesis ─────────────────────────────────────────────────────────
# Velocidad: 0.75=lenta (elegante), 1.0=normal, 1.25=rápida
DEFAULT_RATE=0.92

# Tono: -6 a +6 semitonos. -1 = ligeramente más cálido
DEFAULT_PITCH=-1

# Volumen: -50 a +50 porcentaje
DEFAULT_VOLUME=0

# Límite de caracteres por solicitud
MAX_TEXT_LENGTH=1000

# Límite de solicitudes por IP por minuto
MAX_REQUESTS_PER_MINUTE=20

# ── Seguridad (opcional) ──────────────────────────────────────────────
# Clave compartida con Express para proteger endpoints de síntesis
# VOICE_SHARED_KEY=tu_clave_compartida

# ── Servidor ─────────────────────────────────────────────────────────
# Puerto del servicio voice API
PORT=8001

# Orígenes CORS permitidos (comma-separated)
ALLOWED_ORIGINS=*

# ── Express integration ──────────────────────────────────────────────
# URL del voice API desde Express (server.ts)
# VOICE_API_URL=http://localhost:8001
