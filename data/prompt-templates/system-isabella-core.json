class Federation(str, Enum):
    SECURITY = "SECURITY_IDENTITY_FEDERATION"
    GOVERNANCE = "GOVERNANCE_POLICY_FEDERATION"
    DEVICE = "DEVICE_MESH_FEDERATION"
    TELEMETRY = "TELEMETRY_FEDERATION"
    RESILIENCE = "RESILIENCE_FALLBACK_FEDERATION"
    STORAGE = "STORAGE_STATE_FEDERATION"
    QUANTUM = "QUANTUM_ENGINE_FEDERATION"


class Status(str, Enum):
    OK = "ok"
    DEGRADED = "degraded"
    REJECTED = "rejected"
    ERROR = "error"


class ExecutionMode(str, Enum):
    QUANTUM_SIMULATOR = "quantum_simulator"
    QUANTUM_HARDWARE = "quantum_hardware"
    CLASSICAL_FALLBACK = "classical_fallback"
    DIAGNOSTIC = "diagnostic"
    REJECTED = "rejected"


class BridgeError(Exception):
    def __init__(
        self,
        code: str,
        message: str,
        federation: Federation,
        *,
        retryable: bool = False,
        status: int = 400,
    ) -> None:
        super().__init__(message)
        self.code = code
        self.message = message
        self.federation = federation
        self.retryable = retryable
        self.status = status


