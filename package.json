{
  "name": "isabella-mexa",
  "private": true,
  "version": "5.3.0",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "verify:package-policy": "node scripts/verify-package-policy.cjs",
    "audit:deps": "pnpm audit",
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm run lint && pnpm test && pnpm run build",
    "smoke": "node scripts/smoke.mjs",
    "load:test": "k6 run tests/load/api-smoke.k6.js",
    "quantum:diagnose": "python3 scripts/quantum/isabella_quantum_bridge_v3.py < scripts/quantum/diagnose.json",
    "check:env": "tsx scripts/check-env.ts"
  },
  "dependencies": {
    "@idlen/chat-sdk": "^1.0.5",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@statsig/js-client": "^3.33.4",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/connect": "^1.0.0",
    "@vercel/speed-insights": "^2.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "ai": "^7.0.78",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^13.1.1",
    "ioredis": "^5.6.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-window": "^1.8.11",
    "recharts": "^2.15.4",
    "statsig-node-lite": "^0.5.3",
    "stripe": "^17.4.0",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react-window": "^1.8.8",
    "@types/three": "^0.185.4",
    "@vercel/node": "^7.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "undici": "^7.14.0",
    "ajv": "^8.18.0",
    "uuid": "^11.1.1",
    "path-to-regexp": "^6.3.0"
  },
  "optionalDependencies": {
    "@google/genai": "^2.4.0"
  },
  "allowScripts": {
    "esbuild@0.27.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true
  }
}